# Optional local OpenAI-compatible services. The default CLI mode is offline.
# This file is documentation; the program does not load .env automatically.
# Export selected variables and explicitly use --llm-mode on to enable requests.
BRIDGE_EVIDENCE_BASE_URL=http://127.0.0.1:8000/v1
BRIDGE_EVIDENCE_MODEL=your-served-model-name
BRIDGE_EVIDENCE_FAST_MODEL=your-served-model-name
BRIDGE_EVIDENCE_API_KEY=
BRIDGE_EVIDENCE_SEMANTIC_BASE_URL=http://127.0.0.1:8001/v1
BRIDGE_EVIDENCE_EMBEDDING_MODEL=your-embedding-model-name
BRIDGE_EVIDENCE_RERANKER_MODEL=your-reranker-model-name
BRIDGE_EVIDENCE_SEMANTIC_API_KEY=

# Store local reports, results, logs, and caches outside the source tree.
# BRIDGE_EVIDENCE_CACHE_DIR=/path/to/private/cache
# BRIDGE_EVIDENCE_WORK_DIR=/path/to/private/work
